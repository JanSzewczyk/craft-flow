{
  "name": "craft-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "lint:ci": "eslint . -o eslint-results.sarif -f @microsoft/eslint-formatter-sarif",
    "lint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ci": " playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "test:storybook": "vitest --project=storybook --coverage --passWithNoTests",
    "test:storybook:coverage": "vitest run --project=storybook --coverage.enabled --coverage.reportsDirectory=coverage-storybook",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project=unit --passWithNoTests",
    "test:unit:coverage": "vitest run --project=unit --coverage.enabled --coverage.reportsDirectory=coverage-unit",
    "test:watch": "vitest watch --passWithNoTests",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.19",
    "@hookform/resolvers": "^6.0.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@szum-tech/design-system": "^3.21.9",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@storybook-community/storybook-dark-mode": "^7.1.4",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@szum-tech/eslint-config": "^2.3.2",
    "@szum-tech/prettier-config": "^1.6.5",
    "@szum-tech/semantic-release-config": "^2.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "mimicry-js": "^1.3.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "storybook": "^10.6.3",
    "storybook-addon-tag-badges": "^3.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
